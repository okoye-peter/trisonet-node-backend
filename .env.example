NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# Authentication
JWT_SECRET=
JWT_REFRESH_SECRET=

# Cloudinary Setup for File Uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# termii (sms + email). Mail provider (termii vs zoho) is controlled by the
# shared "mail_provider" row in the `settings` table (same DB the PHP app uses),
# editable from the PHP admin Settings screen - not by an env var here.
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_EMAIL_CONFIG_ID=
# optional - defaults to TERMII_EMAIL_CONFIG_ID when blank
TERMII_TEMPLATE_EMAIL_CONFIG_ID=
TERMII_WELCOME_TEMPLATE_ID=
# id of the PUK template in the Termii dashboard (see email-templates/termii-puk-code.html).
# When blank, PUK emails fall back to Termii's generic "verification code" OTP template.
TERMII_PUK_TEMPLATE_ID=

# zoho (email)
ZOHO_EMAIL=
ZOHO_APP_PASSWORD=
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465

# paga
PAGA_USERNAME=
PAGA_SECRET_KEY=
PAGA_HMAC_KEY=
PAGA_BASE_URL=
PAGA_TEST_MODE=false
PAGA_BUSINESS_PUBLIC_ID=
PAGA_BUSINESS_PASSWORD=
PAGA_CALLBACK_URL=

# VTU
VTU_USERNAME=
VTU_PASSWORD=
VTU_BASE_URL=

# prembly
PREMBLY_API_KEY=